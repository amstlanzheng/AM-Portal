# ============================================
# AM Portal 环境变量示例
# 复制此文件为 .env.local 并填入实际值
# .env.local 已在 .gitignore 中排除，不会被提交
# ============================================

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=am_portal
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ---------- MinIO ----------
# 后端连接 MinIO 的地址（可以是内网地址，如 http://111.231.5.203:9990）
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# 对象存储 bucket，需与现有文件保持一致
MINIO_BUCKET_NAME=amst-ai
# 浏览器访问文件的对外地址（必须与线上访问域名一致，建议 HTTPS）
# 留空会回退使用 MINIO_ENDPOINT，若 endpoint 是内网地址会导致图片无法访问
MINIO_PUBLIC_URL=https://file.lanzhs.com

# ---------- DeepSeek AI ----------
DEEPSEEK_API_KEY=your_deepseek_api_key

# ---------- Web 端口 ----------
# 前端访问端口（宿主机）
WEB_PORT=2887
# 后端 API 端口（宿主机）
BACKEND_PORT=2888
